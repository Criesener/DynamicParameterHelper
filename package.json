{
  "name": "dynamic-parameter-helper",
  "version": "1.0.0",
  "description": "Dynamic Parameter Helper for XML/JSON path extraction with SAP CI integration",
  "main": "src/DocumentParser.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:performance": "node benchmark/index.js",
    "test:all": "npm run test && npm run test:e2e && npm run test:performance",
    "lint": "eslint src/**/*.js",
    "start": "open demo.html"
  },
  "keywords": ["xml", "json", "xpath", "jsonpath", "sap", "ci", "testing"],
  "author": "Christian Riesener",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.8",
    "benchmark": "^2.1.4",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/docs/",
      "/e2e/",
      "/benchmark/"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.js"
    ],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"]
  }
}