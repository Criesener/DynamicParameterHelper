{
  "name": "dynamic-parameter-helper",
  "version": "1.0.0",
  "description": "Dynamic Parameter Helper for XML/JSON path extraction with SAP CI integration",
  "main": "src/DocumentParser.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:performance": "node benchmark/index.js",
    "test:all": "npm run test && npm run test:e2e && npm run test:performance",
    "lint": "eslint src/**/*.js",
    "start": "open demo.html",

    "build": "node scripts/build-single-file.js",
    "build:rollup-old": "rollup -c",
    "build:rollup": "rollup -c",
    "build:rollup:debug": "rollup -c --environment BUILD:debug",
    "build:webpack": "webpack --mode production",
    "build:webpack:dev": "webpack --mode development",
    "build:webpack:analyze": "ANALYZE=true webpack --mode production",
    "build:all": "npm run build:rollup && npm run build:webpack",
    "build:clean": "rm -rf dist dist-webpack",
    "build:analyze": "npm run build:all && node scripts/analyze-bundle.js",
    "build:size": "npm run build && du -sh dist/* dist-webpack/*",
    "serve:dist": "cd dist && python3 -m http.server 8080",
    "serve:webpack": "cd dist-webpack && python3 -m http.server 8081"
  },
  "keywords": [
    "xml",
    "json",
    "xpath",
    "jsonpath",
    "sap",
    "ci",
    "testing"
  ],
  "author": "Christian Riesener",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@playwright/test": "^1.40.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jest": "^29.5.8",
    "babel-loader": "^10.0.0",
    "benchmark": "^2.1.4",
    "css-loader": "^7.1.2",
    "eslint": "^8.54.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.0.1",
    "mini-css-extract-plugin": "^2.9.2",
    "rollup": "^4.46.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-html-bundle": "^0.0.3",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.101.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 20,
        "lines": 25,
        "statements": 25
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/docs/",
      "/e2e/",
      "/benchmark/"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
